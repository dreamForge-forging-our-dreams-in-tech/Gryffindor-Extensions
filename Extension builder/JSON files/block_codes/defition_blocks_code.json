{
    "setMetaData": {
        "singleLine": true,
        "debuggingConditions": [
            {
                "type": "Error",
                "message": "Incorrect typing conventions used: only lowercase and numbers are allowed.",
                "trigger": [
                    "[METATAG]",
                    " == ",
                    "'id'"
                ],
                "condition": [
                    "/[A-Z]/.test(",
                    "[VALUE]",
                    ") || /-/.test(",
                    "[VALUE]",
                    ") || /_/.test(",
                    "[VALUE]",
                    "|| / /.test(",
                    "[VALUE]",
                    "))"
                ]
            }
        ],
        "code": [
            "[METATAG]",
            ": ",
            "[VALUE]",
            ","
        ]
    },
    "createListItem": {
        "singleLine": true,
        "code": [
            "{ text: ",
            "[NAME]",
            ", value: ",
            "[VALUE]",
            "},"
        ]
    },
    "generateMenu": {
        "singleLine": false,
        "code": [
            "[RAW_MENUNAME]",
            ": {",
            "acceptReporters: ",
            "[REPORTERS]",
            ", items: [",
            "[SUBSTACK]",
            "]",
            "}"
        ]
    }
}